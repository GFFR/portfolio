# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model (fixed for consistent voice + cost)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Site metadata sent to OpenRouter
SITE_URL=https://goncalofframalho.com
SITE_TITLE=Gonçalo Ramalho · Product Console

# Budget guardrail (USD per calendar month, UTC)
MONTHLY_BUDGET_USD=5

# Token pricing estimates for budget tracking (USD per 1M tokens)
INPUT_COST_PER_M=0.15
OUTPUT_COST_PER_M=0.60

# Rate limit: max chat requests per IP per 15 minutes
RATE_LIMIT_MAX=20

# Server
PORT=3000
NODE_ENV=production

# Optional paths (defaults work in Docker)
# KB_PATH=/app/data/cv-knowledge.json
# USAGE_FILE_PATH=/app/data/usage.json
